<iscontent type="text/html" charset="UTF-8" />
<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN">

<html>
<head>

</head>

<body>
    <table width="100%" cellpadding="0" cellspacing="0">
        <tr>
            <td align="center" style="background:#e0e0e0;padding:50px 0;">
                <center>
                    <table style="background:#ffffff;border:1px solid #999999;width:680px;">
                        <tr>
                            <td style="font-size:12px;font-family:arial;padding:20px 10px;vertical-align:top;">
                                <isloop iterator="${pdict.titles}" alias="title" status="loopstate">
                                    <p style="font-family:georgia;font-size:20px;"><isprint value="${title}" encoding="off"/></p>
                                </isloop>
                                <isloop iterator="${pdict.messages}" alias="message" status="loopstate">
                                    <p><isprint value="${message}" encoding="off"/></p>
                                </isloop>
                                <isloop iterator="${pdict.limits}" alias="limit" status="loopstate">
                                    <p><isprint value="${limit}" encoding="off"/></p>
                                </isloop>
                            </td>
                        </tr>
                    </table>
                </center>
            </td>
        </tr>
    </table>
</body>

</html>
