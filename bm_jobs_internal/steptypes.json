        "@type-id": "custom.TransferProductCustomAttributes",
        "@supports-site-context": "true",
        "@supports-organization-context": "true",
        "description": "Batch job to transfer one custom attribute to another custom attribute via a product feed",
        "module": "bm_jobs_internal/cartridge/scripts/jobs/transferCustomAttributes",
        "function": "transferProductCustomAttributes",
        "parameters": {
          "parameter": [
            {
              "@name": "FileName",
              "description": "File name pattern (Default is \".*\")",
              "@type": "string",
              "@required": "false",
              "@trim": "true"
            },
            {
              "@name": "CatalogId",
              "description": "Catalog ID to import it into",
              "@type": "string",
              "@required": "true",
              "@trim": "true"
            },
            {
              "@name": "SourceCustomAttribute",
              "description": "Source Custom attribute to copy from",
              "@type": "string",
              "@required": "true",
              "@trim": "true"
            },
            {
              "@name": "SourceCustomAttributeLocaleId",
              "description": "Source Custom Attribute Locale ID to copy from. Use a - instead of _",
              "@type": "string",
              "@required": "false",
              "@trim": "true"
            },
            {
              "@name": "TargetCustomAttribute",
              "description": "Target Custom Attribute to set",
              "@type": "string",
              "@required": "true",
              "@trim": "true"
            },
            {
              "@name": "TargetCustomAttributeLocaleId",
              "description": "Target Attribute Locale ID to paste data. Use a - instead of _",
              "@type": "string",
              "@required": "false",
              "@trim": "true"
            }
          ]
        },
        "transactional": "true",
        "status-codes": {
          "status": [
            {
              "@code": "ERROR",
              "description": "Used when an error occurred."
            },
            {
              "@code": "OK",
              "description": "Used when everything went well."
            }
          ]
        }
      },
