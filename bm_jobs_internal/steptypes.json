      {
        "@type-id": "custom.WriteCustomObjectToDelimitedFile",
        "@supports-parallel-execution": "false",
        "@supports-site-context": "true",
        "@supports-organization-context": "true",
        "description": "Job step for reading, processing, and writing custom object data to a single delimited file (single threaded)",
        "module": "bm_jobs_internal/cartridge/scripts/jobs/writeCustomObjectToDelimitedFile",
        "function": "writeCustomObjectToDelimitedFile",
        "transactional": "false",
        "parameters": {
          "parameter": [
            {
              "@name": "Type",
              "@type": "string",
              "@required": "true",
              "description": "Type of custom object",
              "default-value": "required"
            },
            {
              "@name": "Group",
              "@type": "string",
              "@required": "true",
              "description": "Only exports attributes found in group",
              "default-value": "required"
            },
            {
              "@name": "Delimiter",
              "@type": "string",
              "@required": "true",
              "description": "Enter one character to delimit the file data",
              "default-value": "required"
            },
            {
              "@name": "WritePath",
              "@type": "string",
              "@required": "true",
              "description": "Enter the path in IMPEX with optional timestamp identifier {0} example: /subscribers/subscriber-export-{0}.csv",
              "default-value": "required"
            },
            {
              "@name": "BatchQueryRangeInMinutes",
              "@type": "long",
              "@required": "true",
              "description": "increment query date for crawling through time",
              "default-value": "20"
            },
            {
              "@name": "StartQueryDateInDays",
              "@type": "long",
              "@required": "true",
              "description": "Must match the custom objects retention setting",
              "default-value": "10"
            },
            {
              "@name": "AttributeDateFormat",
              "@type": "string",
              "@required": "false",
              "description": "Transform dates written to file in this format (optional)"
            }
          ]
        },
        "status-codes": {
          "status": [
            {
              "@code": "ERROR",
              "description": "Used when an error occured during execution"
            },
            {
              "@code": "OK",
              "description": "Used when the execution finished successfully"
            }
          ]
        }
      },
