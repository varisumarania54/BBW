/*
By default the unit is 'px'.  
If you would like to have a different unit of measure pass in with printStyle function.  
NOTE: whatever you pass in will be used.
cloneStyles is used to clone the email style object so you can reuse certain styles
*/
function printStyles(style:JSON, unit:String) {
    //takes a json object and builds a style rule from it
    var cssStyle = '';
    var defaultUnit = 'px';
    
    if(!unit){
        unit = defaultUnit;
    }
    
    for(var key in style)
    {
        var value = style[key];         

        if(typeof value === 'number' ){
            value = value + unit;
        }
        cssStyle += key + ':' + value + ';';
    }
    
    return cssStyle;

}

//function for cloning existing styles into a new object
function cloneStyles(style:JSON) {
    function c(style) {
        for (var i in style) {
            this[i] = style[i];
        }
    }
    return new c(style);
};
