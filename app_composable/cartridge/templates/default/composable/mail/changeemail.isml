<iscontent type="text/html" charset="UTF-8" compact="true"/>
<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN">
<subject>${Resource.msg('changeemail.subject','mail',null)}</subject>
<from>
    <isprint value="${Resource.msgf('contact.fromname','mail',null, dw.system.Site.getCurrent().getCustomPreferenceValue('customerServiceEmail'))}" encoding="off"/>
</from>
<html>
<head>
    <meta name="x-apple-disable-message-reformatting">  <!-- Disable auto-scale in iOS 10 Mail entirely -->
    <meta name="viewport" content="width=device-width; initial-scale=1; maximum-scale=10.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
	<title>${Resource.msg('changeemail.title','mail',null)}</title>
	<style type="text/css">
	    body,
	    table,
	    td {
	       font-family: 'HelveticaNeue-Light','Helvetica Neue Light','Helvetica Neue',Helvetica,Arial,'Lucida Grande',sans-serif;
	    }
	</style>
</head>
<body>
<isinclude template="composable/mail/mailstyles"/>
<table width="100%" cellpadding="0" cellspacing="0">
	<tr>
		<td align="center" style="${printStyles(container)}">
			<center>
				<table style="${printStyles(containertable)}">
				    
				    <isinclude template="composable/mail/mailheader"/>
				    
					<tr>
						<td style="${printStyles(contentwrapper)}">
						
							<h1 style="margin: 0 42px 15px; font-size: 28px; font-weight: normal; font-family: 'HelveticaNeue-Light','Helvetica Neue Light','Helvetica Neue',Helvetica,Arial,sans-serif;">
                                ${Resource.msgf('customer.greeting', 'mail', null, pdict.firstName)}
                            </h1>
                            
                            <p style="margin: 22px 42px 0; color: #005699; font-size: 22px; line-height: 22px; font-family: 'HelveticaNeue-Light','Helvetica Neue Light','Helvetica Neue',Helvetica,Arial,sans-serif; font-weight: bold;">
                                ${Resource.msg('changeemail.message1','mail',null)}
                            </p>

                            <p style="margin: 0 42px 25px; font-size: 22px; line-height: 25px; font-family: 'HelveticaNeue-Light','Helvetica Neue Light','Helvetica Neue',Helvetica,Arial,sans-serif;">
                                ${Resource.msg('changeemail.message2','mail',null)}
                            </p>
                            
                            <div style="border: 3px solid #f2f2f2; padding: 40px 0 50px; text-align: center;">
                                <p style="margin: 0 0 26px; font-size: 18px; line-height: 22px;">
                                    ${Resource.msg('changeemail.message3','mail',null)}
                                </p>

                                <isset name="mail_my_account" value="${dw.content.ContentMgr.getContent('bbw-email-rebuild-my-account')}" scope="page" />
			                    <isif condition="${mail_my_account != null}">
                                    <isprint value="${mail_my_account.custom.body}" encoding="off" />
                                </isif>
                            </div>
							
							<p style="text-align: center; margin: 20px 0 0; font-size: 18px; line-height: 26px;">
                                <isprint value="${Resource.msg('customer.support','mail',null)}" encoding="off" />
                                <isprint value="${Resource.msg('customer.support.cta','mail',null)}" encoding="off" />
                            </p>	
						</td>
					</tr>
					
					<isinclude template="composable/mail/mailfooter"/>
					
				</table>						
			</center>
		</td>
	</tr>
</table>
	
	
</body>
</html>