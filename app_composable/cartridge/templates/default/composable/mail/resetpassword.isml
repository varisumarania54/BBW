<iscontent type="text/html" charset="UTF-8" compact="true" />
<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN">
<subject>${pdict.subject}</subject>
<from>
	<isprint value="${Resource.msgf('contact.fromname', 'mail', null, pdict.fromEmail)}" encoding="off" />
</from>
<html>

<head>
	<meta name="x-apple-disable-message-reformatting"> <!-- Disable auto-scale in iOS 10 Mail entirely -->
	<meta name="viewport" content="width=device-width; initial-scale=1; maximum-scale=10.0;">
	<meta http-equiv="X-UA-Compatible" content="IE=edge" />
	<title>${Resource.msg('passwordreset.subject', 'mail', null)}</title>
	<style type="text/css">
		body,
		table,
		td {
			font-family: 'HelveticaNeue-Light', 'Helvetica Neue Light', 'Helvetica Neue', Helvetica, Arial, 'Lucida Grande', sans-serif;
		}
	</style>
</head>

<body>
	<isinclude template="composable/mail/mailstyles" />
	<table width="100%" cellpadding="0" cellspacing="0">
		<tr>
			<td align="center" style="${printStyles(container)}">
				<center>
					<table cellpadding="0" cellspacing="0" style="${printStyles(containertable)}">

						<isinclude template="composable/mail/mailheader" />

						<tr>
							<td style="${printStyles(contentwrapper)}">
								<h1
									style="margin: 0 0 15px; font-size: 18px; font-weight: 700; font-family: 'HelveticaNeue-Light','Helvetica Neue Light','Helvetica Neue',Helvetica,Arial,sans-serif;">
									${Resource.msgf('passwordreset.greeting', 'mail', null, pdict.firstName)}
								</h1>

								<p
									style="margin: 0 0 9px; font-size: 16px; line-height: 24px; font-weight: 400; font-family: 'HelveticaNeue-Light','Helvetica Neue Light','Helvetica Neue',Helvetica,Arial,sans-serif;">
									${Resource.msg('passwordreset.message', 'mail', null)}
								</p>

								<p style="margin: 0 0 12px; font-size: 16px; font-weight: 700; line-height: 28px;">
									${Resource.msg('passwordreset.expiration', 'mail', null)}
								</p>
							</td>

						</tr>
						<tr>
							<td style="${printStyles(contentwrapper)}">
								<table align="center" cellpadding="0" cellspacing="0" style="width:${Resource.msg('passwordreset.button.width', 'mail', null)}%">
									<tr style="text-align: center;">
										<td style="${printStyles(resetpasswordlinktd)}">
											<a href="${pdict.passwordResetLink}"
												title="${Resource.msg('passwordreset.subject', 'mail', null)}"
												style="text-decoration:none; color:white;">${Resource.msg('passwordreset.button', 'mail', null)}</a>
										</td>
									</tr>
								</table>
							</td>
						</tr>
						<tr>
						
							<td style="${printStyles(contentwrapper)}">
								<p style="margin: 14px 0 0; font-size: 16px; font-weight: 400; line-height: 24px;">
                            	<isprint value="${Resource.msg('customer.support','mail',null)}" encoding="off" />
                            	<isprint value="${Resource.msg('customer.support.cta','mail',null)}" encoding="off" />
								</p>
							</td>
						</tr>

						<isinclude template="composable/mail/mailfooter" />

					</table>
				</center>
			</td>
		</tr>
	</table>
</body>

</html>