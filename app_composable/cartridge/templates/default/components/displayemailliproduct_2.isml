<iscontent type="text/html" charset="UTF-8" compact="true"/>
<div style="width: 245px;">
    <iscomment>
        Creates a div rendering a product and product line item information.
        p_productli : the product line item to render
        p_formli    : the form line item
        p_editable  : boolean indicating if the pli is editable or not
        p_hideprice : boolean to hide price
        p_hidepromo : boolean to hide promotional message(s)
        p_status    : boolean to show status
        p_attrlinks : boolean to show attributes links
    </iscomment>

    <iscomment>Create page variable representing the product line item</iscomment>
    <isset name="productLineItem" value="${pdict.p_productli}" scope="page"/>
    <iscomment>Create page variable representing the form line item</iscomment>
    <isset name="formLineItem" value="${pdict.p_formli}" scope="page"/>
    <isset name="productCustom" value="${productLineItem.product.custom}" scope="page"/>
    <iscomment>See if the items is part of the site catalog, and online prior to rendering link</iscomment>
    <isif condition="${productLineItem.product == null || (productLineItem.product != null && (!productLineItem.product.assignedToSiteCatalog || !productLineItem.product.online))}">
        <span class="not-available">
            <iscomment>${Resource.msg('cart.removeditem','checkout',null)}</iscomment>
        </span>
        <div style="text-transform: uppercase; font-size: 16px; color: #333; margin-bottom: 15px; line-height: 23px;"><isprint value="${productLineItem.productName}"/></div>
    <iselse/>

        <div style="text-transform: uppercase; font-size: 16px; color: #333; margin-bottom: 15px; line-height: 23px;">
            <iscomment>
                Item has a category context, forward this category context
                MUST use URLUtils.http as creates absolute url and URLUtils.url does not work in case of an email
                e.g. order confirmation email, links inside it are wrong i.e. host name is missing because
                URLUtils.url api returns relative url!!
            </iscomment>
            <isif condition="${('fragranceName' in productCustom) && !empty(productCustom.fragranceName)}">
                <isset name="itemName" value="${productCustom.fragranceName}" scope="page"/>
            <iselseif condition="${('descriptiveName' in productCustom) && !empty(productCustom.descriptiveName)}"/>
                <isset name="itemName" value="${productCustom.descriptiveName}" scope="page"/>
            <iselse/>
                <isset name="itemName" value="${productLineItem.lineItemText}" scope="page"/>
            </isif>
            <isif condition="${productLineItem.product.isVariant() && !(productLineItem.product.getMasterProduct().isSearchable())}">
                <isprint value="${itemName}" encoding="off" />
            <iselseif condition="${!productLineItem.product.isSearchable()}"/>
                <isprint value="${itemName}" encoding="off" />
            <iselseif condition="${productLineItem.describe().ID != 'ProductListItem' && 'categoryID' in productLineItem && productLineItem.categoryID != null}"/>
                <a href="${URLUtils.https('Product-Show','pid', productLineItem.productID, 'cgid', productLineItem.categoryID)}" title="${Resource.msgf('product.label','confirmationEmails',null, itemName)}" style="text-decoration: none; text-transform: uppercase; font-size: 16px; color: #333; line-height: 23px; margin-bottom: 15px; font-family: 'HelveticaNeue-Light', Arial, sans-serif;">
                    <isprint value="${itemName}" encoding="off" />
                </a>
            <iselse/>
                <a href="${URLUtils.https('Product-Show','pid', productLineItem.productID)}" title="${Resource.msgf('product.label','confirmationEmails',null, itemName)}" style="text-decoration: none; text-transform: uppercase; font-size: 16px; color: #333; line-height: 23px; margin-bottom: 15px; font-family: 'HelveticaNeue-Light', Arial, sans-serif;">
                    <isprint value="${itemName}" encoding="off" />
                </a>
            </isif>
        </div>
    </isif>

    <iscomment>Product type</iscomment>
    <iscomment>
     <isif condition="${('productType' in productCustom) && !empty(productCustom.productType)}">
         <div style="color: #666; font-size: 14px;">
            <isprint value="${productCustom.productType}" encoding="off"/>
         </div>
     </isif>
    </iscomment>
    <iscomment>Product size</iscomment>
    <isif condition="${('form' in productCustom) && !empty(productCustom.form)}">
        <div style="color: #666; font-size: 14px; line-height: 18px;">
            <isprint value="${productCustom.form}" encoding="off"/>
        </div>
    </isif>

    <isif condition="${('size' in productCustom) && !empty(productCustom.size)}">
        <div style="color: #666; font-size: 14px; line-height: 18px;">
            <isprint value="${productCustom.size}" encoding="off"/>
        </div>
    </isif>

    <div style="color: #666; font-size: 14px; line-height: 18px;">
		${Resource.msg('order.confirm.item.number','mail',null)}&nbsp;<isprint value="${productLineItem.productID}"/>
    </div>

    <iscomment>product attributes</iscomment>

    <iscomment>render pricing only for editable product line items</iscomment>
    <isif condition="${pdict.p_editable && !empty(productLineItem.product)}">
        <isif condition="${empty(pdict.p_hideprice) || !pdict.p_hideprice}">
            <div class="attribute">
                <span class="label">${Resource.msg('global.price','confirmationEmails',null)}:</span>
                <isset name="Product" value="${productLineItem.product}" scope="pdict"/>
                <isinclude template="components/productPricing"/>
            </div>
        </isif>
    </isif>

    <iscomment>variations</iscomment>
    <isdisplayvariationvalues product="${productLineItem.product}"/>

    <iscomment>product options</iscomment>
    <isif condition="${'optionProductLineItems' in productLineItem && productLineItem.optionProductLineItems.size() > 0}">
        <isloop items="${productLineItem.optionProductLineItems}" var="optionLI" status="loopstate">
            <div style="color: #666; font-size: 14px; line-height: 18px;">
                <isprint value="${optionLI.lineItemText}"/>
            </div>
        </isloop>
    </isif>

    <iscomment>
        Show Edit Details link if
        Product is not null and it is either a variant and online or options product and online
    </iscomment>
    <isif condition="${'bonusProductLineItem' in productLineItem && !productLineItem.bonusProductLineItem && productLineItem.product != null && ((pdict.p_editable && productLineItem.product.isVariant() && productLineItem.product.online) || ('optionProductLineItems' in productLineItem && productLineItem.optionProductLineItems.size() > 0))}">
        <div class="item-edit-details">
            <isif condition="${empty(pdict.p_editable) || pdict.p_editable}">
                <isscript>
                    var liUrl = '';
                    var urlArgs = ['Product-Show'];
                    var urlParams = {
                        pid: productLineItem.productID,
                        Quantity: productLineItem.quantity.value.toFixed(),
                        uuid: productLineItem.UUID,
                        source: 'cart'
                    };

                    // if item has a category context, forward this category context
                    if (productLineItem.describe().ID != 'ProductListItem' && productLineItem.categoryID != null) {
                        urlParams.cgid = productLineItem.categoryID;
                    }

                    if (productLineItem.optionProductLineItems.size() > 0) {
                        var pom : dw.catalog.ProductOptionModel = productLineItem.optionModel;
                        var it : dw.util.Iterator = productLineItem.optionProductLineItems.iterator();

                        while (it.hasNext()) {
                            var oli : dw.order.ProductLineItem = it.next();
                            var opt : dw.catalog.ProductOption = pom.getOption(oli.optionID);
                            urlParams[opt.htmlName] = pom.getOptionValue(opt, oli.optionValueID).ID;
                        }
                    }

                    // construct the urlArgs array with params names and values
                    for (var param in urlParams) {
                        urlArgs.push(param);
                        urlArgs.push(urlParams[param]);
                    }
                    liUrl = dw.web.URLUtils.url.apply(null, urlArgs);
                </isscript>
                <a href="${liUrl}" title="${productLineItem.productName}">${Resource.msg('global.edit', 'confirmationEmails', null)}</a>
            </isif>
        </div>
    </isif>

    <isif condition="${pdict.p_status}">
        <a href="${URLUtils.https('Product-Show','pid', productLineItem.productID)}" title="${Resource.msgf('product.label','confirmationEmails',null, itemName)}">
            <isinclude template="checkout/cart/cartavailability" />
        </a>
    </isif>

    <isif condition="${empty(pdict.p_hidepromo) || !pdict.p_hidepromo}">
        <iscomment>promotional messaging</iscomment>
        <div style="padding-top: 15px;">
            <isloop items="${productLineItem.priceAdjustments}" var="pli" status="loopstate">
                <div style="font-size: 14px; color: #cc0000; line-height: 18px;">
                    <isprint value="${pli.lineItemText}" encoding="off"/>
                </div>
            </isloop>
        </div>
    </isif>

    <iscomment>surcharge message</iscomment>
    <isif condition="${'shippingLineItem' in productLineItem && productLineItem.shippingLineItem != null}">
        <isif condition="${productLineItem.shippingLineItem.surcharge}">
            <div class="promo"><isprint value="${Resource.msg('product.display.surcharge','confirmationEmails',null)}"/></div>
        </isif>
    <iselse/>
        <isscript>
            var defaultMethod : dw.order.ShippingMethod = dw.order.ShippingMgr.getDefaultShippingMethod();
            var shippingModel : dw.order.ProductShippingModel = dw.order.ShippingMgr.getProductShippingModel(productLineItem.getProduct());
            var shippingCost : dw.order.ProductShippingCost = null;
            if (null!=defaultMethod) {
                shippingCost = shippingModel.getShippingCost(defaultMethod);
            }
        </isscript>
        <isif condition="${!empty(shippingCost) && shippingCost.surcharge}">
            <div class="promo"><isprint value="${Resource.msg('product.display.surcharge','confirmationEmails',null)}"/></div>
        </isif>
    </isif>

</div>
